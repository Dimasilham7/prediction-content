# Cloudflare Workers AI (Clef classifier) — optional if USE_LOCAL_FALLBACK=true
CF_ACCOUNT_ID=
CF_API_TOKEN=
CLEF_MODEL=@cf/cloudflare/clef
CLEF_MODEL_NAME=clef

# Local fallback when Clef fails / no CF credentials
USE_LOCAL_FALLBACK=true

# Optional LLM suggestion providers (leave empty to use rules-only)
# User can also pass keys per-request from the UI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ENABLE_LLM_SUGGESTIONS=false
DEFAULT_SUGGESTION_PROVIDER=rules
DEFAULT_TEMPERATURE=0.3

# ffmpeg / ffprobe (defaults to D:\devtools if setup-env.ps1 was sourced)
FFMPEG_PATH=D:\devtools\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=D:\devtools\ffmpeg\bin\ffprobe.exe

# Hugging Face cache on D:
HF_HOME=D:\devtools\hf-cache
TORCH_HOME=D:\devtools\torch-cache

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
CORS_ORIGINS=http://localhost:3000
